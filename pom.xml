<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build for the CCF 1.x Eclipse plugin set, replacing Eclipse PDE.

  One module with seven source roots, one per bundle. The bundles depend on each other
  through Require-Bundle (com.collabnet.ccf.teamforge_sw needs types from
  com.collabnet.ccf.teamforge, and six of the seven need com.collabnet.ccf), so compiling
  them together resolves those references without needing a p2 target platform.

  Tycho was not used deliberately: it needs a reachable p2 repository for a 2009-era target
  platform, and the Eclipse bundles are all on Maven Central as ordinary jars. See
  legacy/README.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.collabnet.ccf</groupId>
  <artifactId>ccf-gui</artifactId>
  <version>1.5.1-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>CCF Eclipse Plugin</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      The Eclipse artifacts on Maven Central declare a dependency on
      org.eclipse.swt.${osgi.platform} and expect the consumer to define this. Without it
      Maven rejects the POM outright: the artifactId is not a valid id pattern.
    -->
    <osgi.platform>cocoa.macosx.aarch64</osgi.platform>
  </properties>


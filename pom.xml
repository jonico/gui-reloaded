  <build>
    <sourceDirectory>com.collabnet.ccf/src</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-bundle-source-roots</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>com.collabnet.ccf.pt/src</source>
                <source>com.collabnet.ccf.qc/src</source>
                <source>com.collabnet.ccf.sw/src</source>
                <source>com.collabnet.ccf.teamforge/src</source>
                <source>com.collabnet.ccf.teamforge_sw/src</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <excludes>
            <!--
              PTClient imports com.collabnet.helm.ws.* (8 types) which exists in no artifact
              anywhere and never appears in this repository's history - it came from a bundle
              on a CCF update site that is gone. ProjectTrackerSelectionDialog is its only
              referrer and has to go with it, because javac compiles excluded files anyway if
              something on the sourcepath references them.

              The com.collabnet.ccf.migration bundle (9 files) is dropped as a source root
              for the same reason: it needs com.collabnet.ccf.api / .api.model (16 types),
              equally unavailable. Nothing outside that bundle references it.

              11 of 267 files. Stubbing the 24 missing types was rejected: their signatures
              would be guesswork, and inventing an API is worse than declaring it absent.
            -->
            <exclude>com/collabnet/ccf/pt/schemageneration/PTClient.java</exclude>
            <exclude>com/collabnet/ccf/pt/dialogs/ProjectTrackerSelectionDialog.java</exclude>
            <exclude>com/collabnet/ccf/pt/ProjectTrackerMappingSection.java</exclude>
            <exclude>com/collabnet/ccf/pt/ProjectTrackerCcfParticipant.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

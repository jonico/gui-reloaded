    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.swt.cocoa.macosx.aarch64</artifactId>
      <version>3.134.0</version>
          <exclusions>
        <!--
          The Eclipse publications on Central are not really consumable as plain Maven
          dependencies: they declare org.eclipse.swt.${osgi.platform} (an uninterpolated
          placeholder Maven rejects as an invalid artifactId) and use version ranges such as
          [4.5.1,6.0.0) for JNA and javax.annotation that cannot be enumerated. Cutting the
          transitives and naming what is needed keeps the compile classpath deterministic.
        -->
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.jface</artifactId>
      <version>3.39.100</version>
